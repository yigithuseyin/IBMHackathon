// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarColour String   @default("#6366f1")
  totalPoints  Int      @default(0)
  createdAt    DateTime @default(now())

  households          HouseholdMember[]
  ownedHouseholds     Household[]         @relation("HouseholdOwner")
  assignedChores      Chore[]             @relation("ChoreAssignee")
  createdChores       Chore[]             @relation("ChoreCreator")
  completions         ChoreCompletion[]   @relation("CompletionUser")
  approvedCompletions ChoreCompletion[]   @relation("CompletionApprover")
  badges              UserBadge[]         @relation("UserBadgeUser")
  awardedBadges       UserBadge[]         @relation("UserBadgeAwarder")
  streaks             UserStreak[]
}

model Household {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  ownerId    String
  createdAt  DateTime @default(now())

  owner       User              @relation("HouseholdOwner", fields: [ownerId], references: [id])
  members     HouseholdMember[]
  chores      Chore[]
  completions ChoreCompletion[]
  badges      Badge[]
  userBadges  UserBadge[]
  streaks     UserStreak[]
}

model HouseholdMember {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  // role: OWNER | ADMIN | MEMBER
  role        String   @default("MEMBER")
  permissions String   @default("{}")
  isExempt    Boolean  @default(false)
  joinedAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
}

model Chore {
  id          String    @id @default(cuid())
  householdId String
  title       String
  description String?
  // difficulty: EASY | MEDIUM | HARD
  difficulty  String    @default("EASY")
  basePoints  Int       @default(10)
  dueDate     DateTime?
  assignedToId String?
  createdById String
  // status: PENDING | IN_REVIEW | COMPLETED | OVERDUE
  status      String    @default("PENDING")
  isRecurring Boolean   @default(false)
  // recurringFrequency: DAILY | WEEKLY | MONTHLY
  recurringFrequency String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignedTo  User?             @relation("ChoreAssignee", fields: [assignedToId], references: [id])
  createdBy   User              @relation("ChoreCreator", fields: [createdById], references: [id])
  completions ChoreCompletion[]
}

model ChoreCompletion {
  id                 String    @id @default(cuid())
  choreId            String
  completedByUserId  String
  householdId        String
  pointsAwarded      Int       @default(0)
  completedAt        DateTime  @default(now())
  approvedById       String?
  approvedAt         DateTime?
  wasLate            Boolean   @default(false)
  wasEarly           Boolean   @default(false)
  streakAtCompletion Int       @default(0)

  chore       Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)
  completedBy User      @relation("CompletionUser", fields: [completedByUserId], references: [id])
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  approvedBy  User?     @relation("CompletionApprover", fields: [approvedById], references: [id])
}

model Badge {
  id             String  @id @default(cuid())
  name           String  @unique
  description    String
  icon           String
  // type: MILESTONE | BEHAVIOUR | CUSTOM | TEMPORARY
  type           String
  isNegative     Boolean @default(false)
  householdId    String?
  awardCondition String?

  household  Household?  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userBadges UserBadge[]
}

model UserBadge {
  id              String    @id @default(cuid())
  userId          String
  badgeId         String
  householdId     String
  awardedAt       DateTime  @default(now())
  expiresAt       DateTime?
  awardedByUserId String?

  user      User      @relation("UserBadgeUser", fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  awardedBy User?     @relation("UserBadgeAwarder", fields: [awardedByUserId], references: [id])
}

model UserStreak {
  id                 String    @id @default(cuid())
  userId             String
  householdId        String
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastCompletionDate DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}
